rules_version = '2';

// Paddle App — Firestore security rules.
//
// The web API key in assets/pa-firebase.js is public by design; it identifies
// the project and authorizes nothing. THIS FILE is the entire security
// perimeter. Every read and write below is evaluated server-side against a
// verified ID token, so a scraped key gets an attacker exactly nothing beyond
// their own documents.
//
// Deploy:  firebase deploy --only firestore:rules
// Or paste into Firebase console -> Firestore -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----------------------------------------------------------

    function signedIn()   { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Admin is granted by hand-creating admins/{uid} in the Firebase console.
    // Custom claims would be cheaper (they ride in the ID token, no read
    // billed) but setting them needs the Admin SDK, which needs a backend or a
    // Cloud Function on the Blaze plan. This project is a static host with
    // neither, so the collection wins. The token check is listed first so that
    // when a backend does arrive, granting claims starts working with no edit
    // here and the collection can be retired at leisure.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStr(v, maxLen) { return v is string && v.size() <= maxLen; }

    // The field allowlist is the load-bearing part. Without hasOnly() a
    // signed-in user can write arbitrary keys into their own profile and use
    // it as free storage, or inject content that an admin view later renders.
    function validProfile(uid) {
      let d = request.resource.data;
      return d.uid == uid
        && isStr(d.displayName, 60)
        && isStr(d.badgeNumber, 12)
        && isStr(d.depotKey, 60)
        && d.driverType in ['regular', 'relief', 'slate']
        && (!('roles' in d) || d.roles.admin == false)   // no self-promotion
        && d.keys().hasOnly([
             'uid', 'email', 'displayName', 'badgeNumber', 'driverType', 'role',
             'depotKey', 'depotLabel', 'defaultSeasonId', 'seniority',
             'roles', 'createdAt', 'updatedAt', 'schemaVersion', 'lastPlatform'
           ]);
    }

    // ---- public app config ------------------------------------------------
    // Season list and announcements. Readable signed-out because the paddle
    // viewer boots before any auth exists.
    match /config/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---- roles ------------------------------------------------------------
    // operator | supervisor | dispatcher | admin. Console-managed and the
    // authority for anything role-gated; the profile only mirrors it for
    // display. A role on the profile would be self-editable by definition.
    match /roles/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ---- admin allowlist --------------------------------------------------
    // Never client-writable. Combined with the roles.admin == false check in
    // validProfile(), there is no client-reachable privilege escalation path.
    match /admins/{uid} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ---- per-user data ----------------------------------------------------
    match /users/{uid} {
      // get and list are split deliberately. Even though a read rule that
      // passes for one document cannot by itself enumerate a collection,
      // stating it explicitly stops a future edit from opening enumeration by
      // accident.
      allow get:    if isOwner(uid) || isAdmin();
      allow list:   if isAdmin();
      allow create: if isOwner(uid) && validProfile(uid);
      allow update: if isOwner(uid) && validProfile(uid)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(uid);

      match /settings/{toolId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
                     && toolId in ['paddle', 'tracker', 'vacsick', 'ui', 'notifications'];
      }

      match /favorites/{favId} {
        allow read:   if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                     && isStr(request.resource.data.runNo, 8)
                     && isStr(request.resource.data.districtSlug, 64)
                     && isStr(request.resource.data.note, 280)
                     && request.resource.data.day in ['Weekday', 'Saturday', 'Sunday'];
      }

      match /timesheets/{weekId} {
        allow read, write: if isOwner(uid);
        match /days/{dayId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }

      // patterns/{id}, assignments/{date} and vacations/{sunday} are the
      // operator's own schedule and fall through to the catch-all below.

      // Anything new under users/{uid} defaults to owner-only rather than
      // denied, so shipping a new subcollection never requires a rules deploy
      // to land first. Still scoped to the owner, so it grants nothing wider.
      //
      // The {sub} segment is load-bearing. In rules version 2 a recursive
      // wildcard also matches ZERO segments, so a bare {doc=**} here would
      // match users/{uid} itself — and because rules are OR'd, that quietly
      // granted every owner a way round validProfile() above: arbitrary keys
      // in their own profile, and the settings allowlist bypassed the same
      // way. Requiring one named subcollection keeps this rule on
      // subcollection documents only. The two that validate their contents
      // are excluded so their own rules are the only ones that apply to them.
      match /{sub}/{doc=**} {
        allow read, write: if isOwner(uid) && !(sub in ['settings', 'favorites']);
      }
    }

    // ---- swap board -------------------------------------------------------
    // The model is documented at the top of assets/pa-swap.js. The board is
    // PUBLIC to read (a QR flyer opens it with no account) and every write
    // needs a signed-in user. The app only connects operators; nothing here
    // approves a swap, so these rules guard ownership and shape, not the
    // schedule rules (those are advice, checked in the browser).

    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Not posted for a day already gone. A day's grace for time zones; the
    // daily cleanup in functions/ removes what expires.
    function notPast(iso) {
      let p = iso.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(30, 'h') > request.time;
    }

    function validRunCard(c) {
      return c is map
        && isDate(c.date) && isStr(c.runNo, 8) && isStr(c.dayType, 12)
        && isStr(c.routeLabel, 60) && c.routes is list && c.routes.size() <= 12
        && c.keys().hasOnly(['date', 'dayType', 'runNo', 'routeLabel', 'routes', 'owl',
                             'reportMin', 'finishMin', 'payHours', 'swing']);
    }

    function validOffer() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'v', 'kind', 'status', 'posterUid', 'posterName', 'depotKey', 'depotLabel',
               'seasonId', 'seasonLabel', 'weekStart', 'give', 'wants', 'prefs', 'posterBusy',
               'expiresOn', 'startsAtMs', 'matchedUid', 'matchedName', 'matchedAt', 'arrangedBy',
               'reportCount', 'createdAt', 'updatedAt'
             ])
        && d.posterUid is string
        && isStr(d.posterName, 60) && d.posterName.size() > 0
        && isStr(d.depotKey, 60) && isStr(d.depotLabel, 60)
        && isStr(d.seasonId, 40) && isStr(d.seasonLabel, 60)
        && d.kind in ['give', 'dayoff']
        && d.status in ['open', 'matched', 'arranged', 'cancelled']
        && isDate(d.weekStart) && isDate(d.expiresOn)
        && (!('startsAtMs' in d) || d.startsAtMs is int)
        && validRunCard(d.give)
        && d.wants is list && d.wants.size() >= 1 && d.wants.size() <= 8
        && d.prefs is map && (!('note' in d.prefs) || isStr(d.prefs.note, 140))
        && d.posterBusy is map && d.posterBusy.size() <= 9;
    }

    function offerDoc(offerId) { return get(/databases/$(database)/documents/swapOffers/$(offerId)).data; }

    match /swapOffers/{offerId} {
      // Anyone, signed out included, except an offer hidden by reports. The
      // board's query filters status == 'open', which is how a LIST passes.
      allow read: if resource.data.status != 'hidden'
                  || (signedIn() && (resource.data.posterUid == request.auth.uid
                                     || resource.data.matchedUid == request.auth.uid))
                  || isAdmin();

      allow create: if signedIn() && validOffer()
                    && request.resource.data.posterUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && !('matchedUid' in request.resource.data)
                    && !('reportCount' in request.resource.data)
                    && notPast(request.resource.data.expiresOn);

      // The poster edits, picks someone, marks arranged or cancels. Who they
      // pick must have said "I'm interested". A hidden offer stays hidden and
      // reportCount is the server's alone.
      allow update: if signedIn() && validOffer()
                    && resource.data.posterUid == request.auth.uid
                    && request.resource.data.posterUid == resource.data.posterUid
                    && resource.data.status != 'hidden'
                    && request.resource.data.get('reportCount', 0) == resource.data.get('reportCount', 0)
                    && (request.resource.data.status != 'matched'
                        || exists(/databases/$(database)/documents/swapOffers/$(offerId)/interest/$(request.resource.data.matchedUid)));

      // The person picked may only mark it arranged.
      allow update: if signedIn()
                    && resource.data.status == 'matched'
                    && resource.data.matchedUid == request.auth.uid
                    && request.resource.data.status == 'arranged'
                    && request.resource.data.arrangedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'arrangedBy', 'updatedAt']);

      allow delete: if signedIn() && resource.data.posterUid == request.auth.uid;
      allow write:  if isAdmin();

      // "I'm interested": the operator and the poster can see it, nobody else.
      match /interest/{iuid} {
        allow read: if signedIn()
                    && (request.auth.uid == iuid || offerDoc(offerId).posterUid == request.auth.uid);
        allow create, update: if signedIn() && request.auth.uid == iuid
                    && offerDoc(offerId).status == 'open'
                    && offerDoc(offerId).posterUid != iuid
                    && request.resource.data.uid == iuid
                    && isStr(request.resource.data.name, 60)
                    && request.resource.data.color in ['green', 'yellow', 'red']
                    && (!('note' in request.resource.data) || isStr(request.resource.data.note, 140))
                    && (request.resource.data.get('run', null) == null || validRunCard(request.resource.data.run))
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'run', 'wantIndex', 'color', 'reason', 'note', 'createdAt', 'updatedAt']);
        // Withdrawn by the operator, or dismissed by the poster.
        allow delete: if signedIn()
                    && (request.auth.uid == iuid || offerDoc(offerId).posterUid == request.auth.uid);
      }

      // Phone / email. Each person writes their own; it is readable by the
      // other ONLY once the poster has picked that person.
      match /contact/{cuid} {
        allow write: if signedIn() && request.auth.uid == cuid
                     && isStr(request.resource.data.name, 60)
                     && isStr(request.resource.data.phone, 30)
                     && isStr(request.resource.data.email, 120)
                     && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'updatedAt']);
        allow read: if signedIn() && (request.auth.uid == cuid || (
                       offerDoc(offerId).status in ['matched', 'arranged']
                       && request.auth.uid in [offerDoc(offerId).posterUid, offerDoc(offerId).matchedUid]
                       && cuid in [offerDoc(offerId).posterUid, offerDoc(offerId).matchedUid]));
      }
    }

    // "Offers I'm interested in" is a collection-group query on uid.
    match /{path=**}/interest/{iuid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // One report per person per offer (the id is offerId_uid). Admins read
    // them; functions/ counts them and hides an offer at three.
    match /swapReports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && reportId == request.resource.data.offerId + '_' + request.auth.uid
                    && request.resource.data.reason in ['fake', 'rude', 'spam', 'other']
                    && (!('note' in request.resource.data) || isStr(request.resource.data.note, 280))
                    && request.resource.data.keys().hasOnly(['offerId', 'reporterUid', 'reason', 'note', 'createdAt']);
      allow read: if isAdmin();
    }

    // ---- phone alert before a run -----------------------------------------
    // The phone plans its own alerts (assets/pa-run-alerts.js); functions/
    // sends what is due and deletes it. One doc per operator per day, id
    // {uid}_{date}, so nobody can write alerts for anyone else or pile up
    // more than one a day. Plus one test alert, {uid}_test, due within
    // ten minutes (the ALERTS screen's "Send a test phone alert").
    match /runAlerts/{alertId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    // One alert per document: {uid}_{date}_{key}. {uid}_{date} is the
                    // older one-a-day form, and {uid}_test the test alert.
                    && (alertId == request.auth.uid + '_' + request.resource.data.date
                        || (request.resource.data.get('key', null) is string
                            && request.resource.data.key.matches('^[a-z0-9]{1,12}$')
                            && alertId == request.auth.uid + '_' + request.resource.data.date + '_' + request.resource.data.key))
                    && (isDate(request.resource.data.date)
                        || (request.resource.data.date == 'test'
                            && request.resource.data.sendAtMs is int
                            && request.resource.data.sendAtMs <= request.time.toMillis() + 600000))
                    && request.resource.data.sendAtMs is int
                    && isStr(request.resource.data.title, 80)
                    && isStr(request.resource.data.body, 200)
                    && request.resource.data.keys().hasOnly(['uid', 'date', 'key', 'sendAtMs', 'title', 'body', 'updatedAt']);
    }

    // ---- deny everything else --------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
